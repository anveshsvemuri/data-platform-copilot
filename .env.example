# Optional. The deterministic grounded mode requires no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
KNOWLEDGE_DIR=knowledge
RETRIEVAL_INDEX=.cache/knowledge-index.json
COPILOT_TRACE_PATH=.cache/traces.jsonl
COPILOT_CACHE_PATH=.cache/responses.json
# Optional explicit rates used only for cost telemetry; no pricing is hard-coded.
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
# Remote MCP mode. Store the bearer token in a secret manager, never in this file.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_SERVER_URL=http://localhost:8000/mcp
